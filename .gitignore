# Рабочие данные конкретной машины - в репозиторий не идут.
# Все три каталога скрипт создаёт сам при первом запуске.

# журнал применённого, инвентаризация ПК, манифест (имя компьютера, список ПО)
state/

# резервные копии: .reg, .pow, .xml задач, payload удалённых приложений
backups/

# подробные логи запусков
logs/
reports/
dist/
WintoolsData/
*.exe.previous
