APPX:Microsoft.Windows.CloudExperienceHost
APPX:Microsoft.Windows.ContentDeliveryManager
APPX:Microsoft.Windows.Search
APPX:Microsoft.UI.Xaml.CBS
APPX:Microsoft.AAD.BrokerPlugin
APPX:Microsoft.AccountsControl
APPX:Microsoft.CredDialogHost
APPX:Microsoft.LockApp
APPX:Microsoft.Win32WebViewHost
APPX:Microsoft.ECApp
APPX:MicrosoftWindows.Client.CBS
APPX:MicrosoftWindows.Client.Core
APPX:MicrosoftWindows.Client.FileExp
APPX:MicrosoftWindows.UndockedDevKit
APPX:Microsoft.WindowsAppRuntime.CBS
APPX:Microsoft.MicrosoftEdgeDevToolsClient
APPX:Microsoft.WebpImageExtension
APPX:Microsoft.LanguageExperiencePackru-RU
APPX:NVIDIACorp.NVIDIAControlPanel
APPX:RealtekSemiconductorCorp.RealtekAudioControl

