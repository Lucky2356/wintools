# ==========================================================================
#  wintweaks tweak table   (ASCII only - the console runs in an OEM codepage)
#
#  ID | PROFILE | RISK | OS | TYPE | TARGET | NAME | VTYPE | VALUE
#
#  PROFILE : core < balanced < extended   (cumulative)
#  RISK    : low | med | high   (high needs /include-risky)
#  OS      : any | win10 | win11
#  TYPE    : REG | SVC | TASK
#  TARGET  : REG = key, SVC = service name, TASK = full task path
#  NAME    : REG value name, @DEFAULT@ for the (Default) value, "-" otherwise
#  VTYPE   : REG_DWORD / REG_SZ ; "start" for SVC ; "state" for TASK
#  VALUE   : REG data (@EMPTY@ = empty string) / sc start keyword / disable
#
#  Rules: no empty fields (use "-"), no pipe, no "!", no spaces in value names.
#  @HKCU@ is replaced at runtime by HKCU (or HKU\<SID> with /user-sid).
# ==========================================================================

# --- privacy / telemetry ---------------------------------------------------
# Telemetry level 1 = Required/Basic. 0 is Enterprise-only and is silently
# treated as 1 on Pro, so we write the value that is actually honoured.
PRIV-TELEMETRY|core|low|any|REG|HKLM\SOFTWARE\Policies\Microsoft\Windows\DataCollection|AllowTelemetry|REG_DWORD|1
PRIV-FEEDBACK-NOTIF|core|low|any|REG|HKLM\SOFTWARE\Policies\Microsoft\Windows\DataCollection|DoNotShowFeedbackNotifications|REG_DWORD|1
PRIV-TAILORED|core|low|any|REG|@HKCU@\Software\Microsoft\Windows\CurrentVersion\Privacy|TailoredExperiencesWithDiagnosticDataEnabled|REG_DWORD|0
PRIV-ADVID-USER|core|low|any|REG|@HKCU@\Software\Microsoft\Windows\CurrentVersion\AdvertisingInfo|Enabled|REG_DWORD|0
PRIV-ADVID-POLICY|core|low|any|REG|HKLM\SOFTWARE\Policies\Microsoft\Windows\AdvertisingInfo|DisabledByGroupPolicy|REG_DWORD|1
PRIV-ACTIVITY-FEED|core|low|any|REG|HKLM\SOFTWARE\Policies\Microsoft\Windows\System|EnableActivityFeed|REG_DWORD|0
PRIV-ACTIVITY-PUB|core|low|any|REG|HKLM\SOFTWARE\Policies\Microsoft\Windows\System|PublishUserActivities|REG_DWORD|0
PRIV-ACTIVITY-UPL|core|low|any|REG|HKLM\SOFTWARE\Policies\Microsoft\Windows\System|UploadUserActivities|REG_DWORD|0
PRIV-INK-TEXT|core|low|any|REG|@HKCU@\Software\Microsoft\InputPersonalization|RestrictImplicitTextCollection|REG_DWORD|1
PRIV-INK-INK|core|low|any|REG|@HKCU@\Software\Microsoft\InputPersonalization|RestrictImplicitInkCollection|REG_DWORD|1
PRIV-SIUF|core|low|any|REG|@HKCU@\Software\Microsoft\Siuf\Rules|NumberOfSIUFInPeriod|REG_DWORD|0
PRIV-CDM-SILENTAPPS|core|low|any|REG|@HKCU@\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager|SilentInstalledAppsEnabled|REG_DWORD|0
PRIV-CDM-SYSPANE|core|low|any|REG|@HKCU@\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager|SystemPaneSuggestionsEnabled|REG_DWORD|0
PRIV-CDM-PREINSTALL|core|low|any|REG|@HKCU@\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager|PreInstalledAppsEnabled|REG_DWORD|0
PRIV-CDM-OEMPREINSTALL|core|low|any|REG|@HKCU@\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager|OemPreInstalledAppsEnabled|REG_DWORD|0
PRIV-CDM-338388|core|low|any|REG|@HKCU@\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager|SubscribedContent-338388Enabled|REG_DWORD|0
PRIV-CDM-338389|core|low|any|REG|@HKCU@\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager|SubscribedContent-338389Enabled|REG_DWORD|0
PRIV-CDM-353694|core|low|any|REG|@HKCU@\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager|SubscribedContent-353694Enabled|REG_DWORD|0
PRIV-CDM-353696|core|low|any|REG|@HKCU@\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager|SubscribedContent-353696Enabled|REG_DWORD|0
PRIV-CONSUMER|balanced|low|any|REG|HKLM\SOFTWARE\Policies\Microsoft\Windows\CloudContent|DisableWindowsConsumerFeatures|REG_DWORD|1
PRIV-SOFTLANDING|balanced|low|any|REG|HKLM\SOFTWARE\Policies\Microsoft\Windows\CloudContent|DisableSoftLanding|REG_DWORD|1
PRIV-LLMNR|balanced|low|any|REG|HKLM\SOFTWARE\Policies\Microsoft\Windows NT\DNSClient|EnableMulticast|REG_DWORD|0
# Windows Error Reporting off = no crash dumps to Microsoft and thinner local
# diagnostics for 3rd party apps. Reversible, but opinionated -> RISK=high.
PRIV-WER|extended|high|any|REG|HKLM\SOFTWARE\Policies\Microsoft\Windows\Windows Error Reporting|Disabled|REG_DWORD|1

