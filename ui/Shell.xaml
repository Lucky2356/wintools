  <Style TargetType="TextBox"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource Raised}"/><Setter Property="CaretBrush" Value="{DynamicResource Accent}"/><Setter Property="SelectionBrush" Value="{DynamicResource Selection}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9"><ScrollViewer x:Name="PART_ContentHost" Margin="0"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="PasswordBox"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource Raised}"/><Setter Property="CaretBrush" Value="{DynamicResource Accent}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="Padding" Value="12,10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9"><ScrollViewer x:Name="PART_ContentHost" Margin="0"/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,8,18,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal"><Border x:Name="Switch" Width="32" Height="18" CornerRadius="9" Background="{DynamicResource Raised}" BorderBrush="{DynamicResource Border}" BorderThickness="1" VerticalAlignment="Center"><Ellipse x:Name="Knob" Fill="{DynamicResource Muted}" Width="12" Height="12" HorizontalAlignment="Left" Margin="2,0"/></Border><ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Switch" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Knob" Property="Fill" Value="{DynamicResource AccentText}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Switch" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="8"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}"><Track.Thumb><Thumb MinHeight="24"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource Border}" CornerRadius="4" Margin="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="12,9"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Frame" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource Selection}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource Selection}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource Raised}"/><Setter Property="MinHeight" Value="40"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
   <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Frame" Background="{DynamicResource Raised}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="9"><Path Data="M 0,0 L 4,4 L 8,0" Stroke="{DynamicResource Muted}" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Muted}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton>
   <ContentPresenter Margin="12,0,32,0" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
   <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" PopupAnimation="Fade"><Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="9" Padding="5" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="320"><ScrollViewer><ItemsPresenter/></ScrollViewer></Border></Popup>
  </Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,6,7"/><Setter Property="Padding" Value="15,13"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Card" Background="{DynamicResource Surface}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="{DynamicResource Raised}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="Background" Value="{DynamicResource Selection}"/><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid>
  <Grid x:Name="Body" Background="{DynamicResource Background}"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0" Padding="18,26,18,18"><DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="8,0,0,14"><StackPanel Orientation="Horizontal"><Border Background="{DynamicResource Accent}" CornerRadius="9" Width="32" Height="32"><Viewbox Margin="6"><Path Data="M 0,0 L 4,18 L 9,9 L 14,18 L 18,0" Stroke="{DynamicResource AccentText}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Viewbox></Border><TextBlock Text="wintools" FontWeight="SemiBold" FontSize="22" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel><TextBlock Text="WINDOWS ПОД КОНТРОЛЕМ" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,14,0,0"/></StackPanel>
    <StackPanel DockPanel.Dock="Bottom"><Border Background="{DynamicResource Surface}" CornerRadius="10" Padding="14" Margin="0,0,0,14"><StackPanel><TextBlock Text="Portable" FontWeight="SemiBold"/><TextBlock x:Name="VersionLabel" Style="{StaticResource MutedText}" FontSize="12" Margin="0,5,0,0"/><TextBlock Text="Без установки и фоновых служб" Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0"/></StackPanel></Border><Button x:Name="ReleaseLink" Content="GitHub Releases  ↗" Style="{StaticResource Ghost}" FontSize="12" Padding="8"/></StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><Button x:Name="NavCatalogue" Content="▦    Каталог действий" Style="{StaticResource Nav}"/><Button x:Name="NavPlan" Content="☷    План изменений" Style="{StaticResource Nav}"/><Button x:Name="NavHistory" Content="↶    История и откат" Style="{StaticResource Nav}"/><Button x:Name="NavCollections" Content="◇    Подборки" Style="{StaticResource Nav}"/><Button x:Name="NavSettings" Content="⚙    Настройки" Style="{StaticResource Nav}"/><Border Height="1" Background="{DynamicResource Border}" Margin="12,10"/><TextBlock Text="ИНСТРУМЕНТЫ" Foreground="{DynamicResource Muted}" FontSize="12" Margin="14,0,0,12"/><Button x:Name="NavApplications" Content="Приложения" Style="{StaticResource Nav}"/><Button x:Name="NavServices" Content="Службы сейчас" Style="{StaticResource Nav}"/><Button x:Name="NavOptimize" Content="Ускорение Windows" Style="{StaticResource Nav}"/><Button x:Name="NavIntegrity" Content="Обслуживание" Style="{StaticResource Nav}"/><Button x:Name="NavNetwork" Content="Проверка сети" Style="{StaticResource Nav}"/><Button x:Name="Diagnose" Content="◉    Диагностика ПК" Style="{StaticResource Nav}"/><Button x:Name="Verify" Content="✓    Сверить настройки" Style="{StaticResource Nav}" FontSize="12"/></StackPanel>
   </ScrollViewer></DockPanel></Border>
   <Grid Grid.Column="1" Margin="24,22,24,14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="168"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="PageEyebrow" Text="ВАШЕ РАБОЧЕЕ ПРОСТРАНСТВО" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,0,0,8"/><TextBlock x:Name="PageTitle" Text="Настройте Windows под себя" FontSize="27" FontWeight="SemiBold"/><TextBlock x:Name="PageHint" Text="Понятные действия. Предпросмотр. Контролируемый откат." Style="{StaticResource MutedText}" Margin="0,8,10,0"/></StackPanel><ComboBox x:Name="Theme" Grid.Column="1" VerticalAlignment="Top" Margin="0,8,0,0" AutomationProperties.Name="Цветовая тема"><ComboBoxItem Content="Как в Windows"/><ComboBoxItem Content="Светлая"/><ComboBoxItem Content="Тёмная"/></ComboBox></Grid>
    <Grid Grid.Row="1">
     <Grid x:Name="CataloguePage"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions><Grid Margin="0,0,12,0"><TextBox x:Name="Search" AutomationProperties.Name="Поиск действий" Height="44" Padding="12,6"/><TextBlock x:Name="SearchHint" Text="Поиск по названию, описанию или ID" Foreground="{DynamicResource Muted}" Margin="16,0" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid><ComboBox x:Name="Category" Grid.Column="1" DisplayMemberPath="Value" SelectedValuePath="Key" AutomationProperties.Name="Категория"/></Grid>
      <Grid Grid.Row="1" Margin="0,12,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><WrapPanel><Button x:Name="RefreshCatalogueServices" Content="↻ Состояние служб" ToolTip="Повторно прочитать состояние служб Windows" Visibility="Collapsed" Style="{StaticResource Ghost}" Padding="8,4" MinHeight="30"/><Button x:Name="BackToGroups" Content="← Разделы" Style="{StaticResource Ghost}" Padding="8,4" MinHeight="30" Margin="0,0,8,0"/><CheckBox x:Name="Favorites" Content="Избранное"/><CheckBox x:Name="Risky" Content="Высокий риск"/><Button x:Name="ClearCollection" Content="Все действия ×" Visibility="Collapsed" Style="{StaticResource Ghost}" Padding="8,4" MinHeight="30"/></WrapPanel><TextBlock x:Name="Count" Grid.Column="1" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center"/></Grid>
      <ScrollViewer x:Name="CatalogueGroups" Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel>
       <DockPanel Margin="0,0,0,16"><Button x:Name="ShowAll" Content="Все действия →" Style="{StaticResource Ghost}" DockPanel.Dock="Right"/><TextBlock x:Name="BrowseTitle" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
       <ItemsControl x:Name="BrowseGroups"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Tag="{Binding Key}" HorizontalContentAlignment="Stretch" Background="{DynamicResource Surface}" Margin="0,0,12,12" Padding="18,20"><StackPanel><TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Muted}" Margin="0,10,0,0"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel></ScrollViewer>
      <Grid x:Name="CatalogueResults" Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1*" MinWidth="280"/></Grid.ColumnDefinitions>
       <Grid><ListBox x:Name="Items" AutomationProperties.Name="Действия"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding DisplayTitle}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock Text="{Binding Summary}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock Text="{Binding ServiceStatus}" Visibility="{Binding ServiceVisibility}" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="0,8,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel x:Name="EmptyCatalogue" Visibility="Collapsed" VerticalAlignment="Center" Margin="22"><TextBlock Text="Ничего не найдено" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Измените запрос или отключите фильтры." Style="{StaticResource MutedText}" Margin="0,10,0,0"/></StackPanel></Grid>
       <Border Grid.Column="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="14" Padding="18"><DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,18,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="Apply" Content="Применить" ToolTip="Применить выбранное действие" Style="{StaticResource Primary}" Padding="8,10"/><Button x:Name="Preview" Grid.Column="2" Content="Предпросмотр" ToolTip="Показать изменения без применения" Padding="8,10"/></Grid><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="Revert" Content="Откатить" Style="{StaticResource Ghost}" Padding="4,8"/><Button x:Name="Star" Grid.Column="1" Content="☆" ToolTip="Избранное" AutomationProperties.Name="Избранное" Style="{StaticResource Ghost}" Padding="4,8"/><Button x:Name="PlanAdd" Grid.Column="2" Content="В план +" ToolTip="Добавить в план изменений; очистка и удаление Edge выполняются отдельно" Style="{StaticResource Ghost}" Padding="4,8"/></Grid></StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>        <StackPanel ><TextBlock Text="ВЫБРАННОЕ ДЕЙСТВИЕ" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,0,0,14"/><TextBlock x:Name="ActionTitle" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="Metadata" Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,12"/></StackPanel>
<TextBlock Text="ЧТО ИЗМЕНИТСЯ" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,0,8"/><TextBlock x:Name="Description" LineHeight="23"/><TextBlock Text="НА ЧТО ОБРАТИТЬ ВНИМАНИЕ" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,18,0,8"/><TextBlock x:Name="Caveat" LineHeight="23"/><TextBlock x:Name="Compatibility" Style="{StaticResource MutedText}" Margin="0,10,0,0"/><Border Height="1" Background="{DynamicResource Border}" Margin="0,18"/><TextBlock Text="ВОЗМОЖНОСТЬ ОТКАТА" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,0,8"/><TextBlock x:Name="Rollback" Style="{StaticResource MutedText}"/></StackPanel></ScrollViewer>
       </DockPanel></Border>
      </Grid>
     </Grid>
     <Grid x:Name="PlanPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock x:Name="PlanStatus" Style="{StaticResource MutedText}" Margin="0,0,0,16"/>
      <ListBox x:Name="PlanItems" Grid.Row="1" AutomationProperties.Name="План изменений"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="{Binding Summary}" Foreground="{DynamicResource Muted}" Margin="0,8,0,0" LineHeight="22"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
      <StackPanel Grid.Row="2" Margin="0,14,0,0"><WrapPanel><Button x:Name="ProfileImport" Content="Загрузить профиль" Style="{StaticResource Ghost}"/><Button x:Name="ProfileExport" Content="Сохранить профиль" Style="{StaticResource Ghost}"/><Button x:Name="PlanUp" Content="Выше ↑" Style="{StaticResource Ghost}"/><Button x:Name="PlanDown" Content="Ниже ↓" Style="{StaticResource Ghost}"/><Button x:Name="PlanRemove" Content="Убрать из плана" Style="{StaticResource Ghost}"/></WrapPanel><WrapPanel Margin="0,8,0,0"><Button x:Name="PlanPreview" Content="Предпросмотр плана" Margin="0,0,10,8"/><Button x:Name="PlanApply" Content="Выполнить план" Style="{StaticResource Primary}" Margin="0,0,10,8"/><Button x:Name="PlanStop" Content="Остановить после действия" Visibility="Collapsed" Margin="0,0,0,8"/></WrapPanel></StackPanel>
     </Grid>
     <Grid x:Name="HistoryPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="HistoryStatus" Style="{StaticResource MutedText}" Margin="0,0,0,16"/><ListBox x:Name="History" Grid.Row="1" AutomationProperties.Name="История запусков"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,6,0,0"/></StackPanel><TextBlock Text="{Binding Status}" Grid.Column="1" Margin="16,0,0,0" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><WrapPanel Grid.Row="2" Margin="0,16,0,0"><Button x:Name="HistoryRevert" Content="Откатить запуск" Style="{StaticResource Primary}" Margin="0,0,10,8"/><Button x:Name="HistoryReport" Content="Открыть отчёт" Visibility="Collapsed" Margin="0,0,10,8"/><Button x:Name="RefreshHistory" Content="Обновить" Margin="0,0,10,8"/><Button x:Name="OpenLogs" Content="Логи ↗" Style="{StaticResource Ghost}"/><Button x:Name="OpenReports" Content="Отчёты ↗" Style="{StaticResource Ghost}"/></WrapPanel></Grid>
     <ScrollViewer x:Name="CollectionsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel/></ScrollViewer>
     <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel HorizontalAlignment="Stretch">
      <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="14" Padding="24"><StackPanel>
       <TextBlock Text="Обновления Wintools" FontSize="22" FontWeight="SemiBold"/>
       <TextBlock x:Name="UpdateStatus" Text="Проверяем наличие новой версии…" Style="{StaticResource MutedText}" Margin="0,12,0,12"/>
       <CheckBox x:Name="AutoCheck" Content="Проверять при запуске и каждые 6 часов"/>
       <CheckBox x:Name="AutoInstall" Content="Скачивать и устанавливать при закрытии"/>
       <CheckBox x:Name="PreviewChannel" Content="Получать предварительные версии (RC)"/>
       <TextBlock Text="Токен и вход в GitHub не нужны. Обновление устанавливается после закрытия приложения: в следующий раз откроется новая версия. История и данные для отката сохраняются." Style="{StaticResource MutedText}" Margin="0,10,0,0"/>
       <ProgressBar x:Name="DownloadProgress" Height="4" Margin="0,18,0,0" Visibility="Collapsed" Foreground="{DynamicResource Accent}" Background="{DynamicResource Raised}" BorderThickness="0"/>
       <WrapPanel Margin="0,18,0,0"><Button x:Name="CheckUpdates" Content="Проверить сейчас" Margin="0,0,10,8"/><Button x:Name="InstallUpdate" Content="Обновить и перезапустить" Style="{StaticResource Primary}" Visibility="Collapsed" Margin="0,0,0,8"/></WrapPanel>
      </StackPanel></Border>
      <Border Background="{DynamicResource Surface}" CornerRadius="14" Padding="24" Margin="0,16,0,0"><StackPanel><TextBlock Text="Защита перед изменениями" FontSize="19" FontWeight="SemiBold"/><CheckBox x:Name="RestorePoint" Content="Запрашивать точку восстановления Windows" Margin="0,16,0,10"/><TextBlock Text="Если Windows не сможет создать точку, причина появится в выводе. Прежние значения настроек Wintools сохраняет отдельно для отката." Style="{StaticResource MutedText}"/></StackPanel></Border>
      <Border Background="{DynamicResource Surface}" CornerRadius="14" Padding="24" Margin="0,16,0,0"><StackPanel><TextBlock Text="Зачем нужна папка WintoolsData" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Здесь находятся ваши настройки, история, резервные копии для отката и рабочие файлы программы. Она позволяет пользоваться Wintools без установки. Для отката прежних изменений сохраняйте папку по исходному пути. Если её удалить, история и возможность вернуть прежние настройки будут потеряны." Style="{StaticResource MutedText}" Margin="0,12,0,14"/><Button x:Name="OpenData" Content="Открыть папку данных ↗" HorizontalAlignment="Left"/></StackPanel></Border>
     </StackPanel></ScrollViewer>
    </Grid>
    <Border Grid.Row="2" Background="{DynamicResource Surface}" CornerRadius="10" Margin="0,16,0,0"><DockPanel><Button x:Name="LogToggle" Content="Вывод операции  ▾" Style="{StaticResource Ghost}" DockPanel.Dock="Top" HorizontalContentAlignment="Left" Padding="14,8" MinHeight="34"/><TextBox x:Name="Output" IsReadOnly="True" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="100" Margin="0,0,0,8" Background="Transparent" BorderThickness="0" Visibility="Collapsed" Text="Результаты предпросмотра и выполнения появятся здесь."/></DockPanel></Border>
    <TextBlock x:Name="Status" Grid.Row="3" Text="Готово к работе" Foreground="{DynamicResource Muted}" FontSize="12" Margin="2,12,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
   </Grid>
  </Grid>
  <Grid x:Name="ConfirmOverlay" Background="#A0000000" Visibility="Collapsed"><Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="16" Width="480" Padding="28" VerticalAlignment="Center" HorizontalAlignment="Center"><StackPanel><TextBlock Text="Подтвердите действие" FontSize="24" FontWeight="SemiBold"/><ScrollViewer MaxHeight="300" Margin="0,18,0,24" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="ConfirmText" LineHeight="23"/></ScrollViewer><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="ConfirmNo" Content="Отмена"/><Button x:Name="ConfirmYes" Grid.Column="2" Content="Продолжить" Style="{StaticResource Primary}"/></Grid></StackPanel></Border></Grid>
 </Grid>
</Window>
