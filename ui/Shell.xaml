<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Wintools" Width="1220" Height="820" MinWidth="940" MinHeight="740" WindowStartupLocation="CenterScreen" Background="{DynamicResource Background}" Foreground="{DynamicResource Text}" FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Window.Resources>
  <SolidColorBrush x:Key="Background" Color="#101415"/><SolidColorBrush x:Key="Sidebar" Color="#14191B"/>
  <SolidColorBrush x:Key="Surface" Color="#1B2224"/><SolidColorBrush x:Key="Raised" Color="#252E30"/>
  <SolidColorBrush x:Key="Border" Color="#303B3D"/><SolidColorBrush x:Key="Text" Color="#F0F5F3"/>
  <SolidColorBrush x:Key="Muted" Color="#9BAEAA"/><SolidColorBrush x:Key="Accent" Color="#B4E0C8"/>
  <SolidColorBrush x:Key="AccentText" Color="#132C21"/><SolidColorBrush x:Key="Selection" Color="#293F36"/>
  <SolidColorBrush x:Key="Danger" Color="#F3B6A5"/>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="MutedText" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="21"/></Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="{DynamicResource Raised}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="16,10"/><Setter Property="MinHeight" Value="40"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.6"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="{DynamicResource AccentText}"/><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/></Style>
  <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource Ghost}"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,3"/><Setter Property="Padding" Value="14,12"/></Style>
  <Style TargetType="TextBox"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource Raised}"/><Setter Property="CaretBrush" Value="{DynamicResource Accent}"/><Setter Property="SelectionBrush" Value="{DynamicResource Selection}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9"><ScrollViewer x:Name="PART_ContentHost" Margin="0"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="PasswordBox"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource Raised}"/><Setter Property="CaretBrush" Value="{DynamicResource Accent}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="Padding" Value="12,10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9"><ScrollViewer x:Name="PART_ContentHost" Margin="0"/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,8,18,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal"><Border x:Name="Switch" Width="32" Height="18" CornerRadius="9" Background="{DynamicResource Raised}" BorderBrush="{DynamicResource Border}" BorderThickness="1" VerticalAlignment="Center"><Ellipse x:Name="Knob" Fill="{DynamicResource Muted}" Width="12" Height="12" HorizontalAlignment="Left" Margin="2,0"/></Border><ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Switch" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Knob" Property="Fill" Value="{DynamicResource AccentText}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Switch" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="8"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}"><Track.Thumb><Thumb MinHeight="24"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource Border}" CornerRadius="4" Margin="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="12,9"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Frame" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource Selection}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource Selection}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource Raised}"/><Setter Property="MinHeight" Value="40"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
   <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Frame" Background="{DynamicResource Raised}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="9"><Path Data="M 0,0 L 4,4 L 8,0" Stroke="{DynamicResource Muted}" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Muted}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton>
   <ContentPresenter Margin="12,0,32,0" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
   <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" PopupAnimation="Fade"><Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="9" Padding="5" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="320"><ScrollViewer><ItemsPresenter/></ScrollViewer></Border></Popup>
  </Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,6,7"/><Setter Property="Padding" Value="15,13"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Card" Background="{DynamicResource Surface}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="{DynamicResource Raised}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="Background" Value="{DynamicResource Selection}"/><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid>
  <Grid x:Name="Body" Background="{DynamicResource Background}"><Grid.ColumnDefinitions><ColumnDefinition Width="204"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0" Padding="18,26,18,18"><DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="8,0,0,30"><StackPanel Orientation="Horizontal"><Border Background="{DynamicResource Accent}" CornerRadius="9" Width="32" Height="32"><TextBlock Text="W" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="wintools" FontWeight="SemiBold" FontSize="22" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel><TextBlock Text="WINDOWS • ПОД КОНТРОЛЕМ" FontSize="9" Foreground="{DynamicResource Muted}" Margin="0,14,0,0"/></StackPanel>
    <StackPanel DockPanel.Dock="Bottom"><Border Background="{DynamicResource Surface}" CornerRadius="10" Padding="14" Margin="0,0,0,14"><StackPanel><TextBlock Text="Portable" FontWeight="SemiBold"/><TextBlock x:Name="VersionLabel" Style="{StaticResource MutedText}" FontSize="11" Margin="0,5,0,0"/><TextBlock Text="Без установки и фоновых служб" Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,0"/></StackPanel></Border><Button x:Name="ReleaseLink" Content="GitHub Releases  ↗" Style="{StaticResource Ghost}" FontSize="12" Padding="8"/></StackPanel>
    <StackPanel><TextBlock Text="РАБОЧАЯ ОБЛАСТЬ" Foreground="{DynamicResource Muted}" FontSize="9" Margin="14,0,0,12"/><Button x:Name="NavCatalogue" Content="▦    Каталог действий" Style="{StaticResource Nav}"/><Button x:Name="NavHistory" Content="↶    История и откат" Style="{StaticResource Nav}"/><Button x:Name="NavUpdates" Content="↓    Обновления" Style="{StaticResource Nav}"/><Button x:Name="NavSettings" Content="⚙    Настройки" Style="{StaticResource Nav}"/><Border Height="1" Background="{DynamicResource Border}" Margin="12,22"/><TextBlock Text="ИНСТРУМЕНТЫ" Foreground="{DynamicResource Muted}" FontSize="9" Margin="14,0,0,12"/><Button x:Name="Diagnose" Content="◉    Диагностика ПК" Style="{StaticResource Nav}"/><Button x:Name="Verify" Content="✓    Проверить изменения" Style="{StaticResource Nav}" FontSize="12"/></StackPanel>
   </DockPanel></Border>
   <Grid Grid.Column="1" Margin="28,22,28,14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="168"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="PageEyebrow" Text="ВАШЕ РАБОЧЕЕ ПРОСТРАНСТВО" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,0,0,8"/><TextBlock x:Name="PageTitle" Text="Настройте Windows под себя" FontSize="27" FontWeight="SemiBold"/><TextBlock x:Name="PageHint" Text="Понятные действия. Предпросмотр. Контролируемый откат." Style="{StaticResource MutedText}" Margin="0,8,10,0"/></StackPanel><ComboBox x:Name="Theme" Grid.Column="1" VerticalAlignment="Top" Margin="0,8,0,0" AutomationProperties.Name="Цветовая тема"><ComboBoxItem Content="Как в Windows"/><ComboBoxItem Content="Светлая"/><ComboBoxItem Content="Тёмная"/></ComboBox></Grid>
    <Grid Grid.Row="1">
     <Grid x:Name="CataloguePage"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions><Grid Margin="0,0,12,0"><TextBox x:Name="Search" AutomationProperties.Name="Поиск действий" Height="44" Padding="12,6"/><TextBlock x:Name="SearchHint" Text="Поиск по названию, описанию или ID" Foreground="{DynamicResource Muted}" Margin="16,0" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid><ComboBox x:Name="Category" Grid.Column="1" DisplayMemberPath="Value" SelectedValuePath="Key" AutomationProperties.Name="Категория"/></Grid>
      <Grid Grid.Row="1" Margin="0,12,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><WrapPanel><CheckBox x:Name="Favorites" Content="Избранное"/><CheckBox x:Name="Risky" Content="Высокий риск"/></WrapPanel><TextBlock x:Name="Count" Grid.Column="1" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center"/></Grid>
      <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1*" MinWidth="280"/></Grid.ColumnDefinitions>
       <Grid><ListBox x:Name="Items" AutomationProperties.Name="Действия"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding DisplayTitle}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock Text="{Binding Summary}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel x:Name="EmptyCatalogue" Visibility="Collapsed" VerticalAlignment="Center" Margin="22"><TextBlock Text="Ничего не найдено" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Измените запрос или отключите фильтры." Style="{StaticResource MutedText}" Margin="0,10,0,0"/></StackPanel></Grid>
       <Border Grid.Column="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="14" Padding="18"><DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,18,0,0"><Button x:Name="Apply" Content="Применить действие" Style="{StaticResource Primary}"/><Button x:Name="Preview" Content="Предпросмотр изменений" Margin="0,8,0,0"/><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="Revert" Content="Откатить" Style="{StaticResource Ghost}" Padding="6,8"/><Button x:Name="Star" Grid.Column="1" Content="☆ Избранное" Style="{StaticResource Ghost}" Padding="6,8"/></Grid></StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>        <StackPanel ><TextBlock Text="ВЫБРАННОЕ ДЕЙСТВИЕ" FontSize="9" Foreground="{DynamicResource Muted}" Margin="0,0,0,14"/><TextBlock x:Name="ActionTitle" FontSize="21" FontWeight="SemiBold"/><TextBlock x:Name="Metadata" Style="{StaticResource MutedText}" FontSize="11" Margin="0,8,0,12"/></StackPanel>
<TextBlock x:Name="Description" LineHeight="23"/><Border Height="1" Background="{DynamicResource Border}" Margin="0,18"/><TextBlock Text="ВОЗМОЖНОСТЬ ОТКАТА" Foreground="{DynamicResource Muted}" FontSize="9" Margin="0,0,0,8"/><TextBlock x:Name="Rollback" Style="{StaticResource MutedText}"/></StackPanel></ScrollViewer>
       </DockPanel></Border>
      </Grid>
     </Grid>
     <Grid x:Name="HistoryPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="HistoryStatus" Style="{StaticResource MutedText}" Margin="0,0,0,16"/><ListBox x:Name="History" Grid.Row="1" AutomationProperties.Name="История запусков"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Run}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,6,0,0"/></StackPanel><TextBlock Text="{Binding Status}" Grid.Column="1" Margin="16,0,0,0" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><WrapPanel Grid.Row="2" Margin="0,16,0,0"><Button x:Name="HistoryRevert" Content="Откатить запуск" Style="{StaticResource Primary}" Margin="0,0,10,8"/><Button x:Name="RefreshHistory" Content="Обновить" Margin="0,0,10,8"/><Button x:Name="OpenLogs" Content="Логи ↗" Style="{StaticResource Ghost}"/><Button x:Name="OpenReports" Content="Отчёты ↗" Style="{StaticResource Ghost}"/></WrapPanel></Grid>
     <ScrollViewer x:Name="UpdatesPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="760" HorizontalAlignment="Left">
      <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="14" Padding="26"><StackPanel><Border Background="{DynamicResource Selection}" CornerRadius="12" Width="48" Height="48" HorizontalAlignment="Left"><TextBlock Text="↓" FontSize="28" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><TextBlock Text="Проверка версии" FontSize="24" FontWeight="SemiBold" Margin="0,20,0,10"/><TextBlock x:Name="UpdateStatus" Text="Проверьте наличие новой версии." Style="{StaticResource MutedText}"/><ProgressBar x:Name="DownloadProgress" Height="4" Margin="0,18,0,0" Visibility="Collapsed" Foreground="{DynamicResource Accent}" Background="{DynamicResource Raised}" BorderThickness="0"/><WrapPanel Margin="0,22,0,0"><Button x:Name="CheckUpdates" Content="Проверить обновления" Style="{StaticResource Primary}" Margin="0,0,10,8"/><Button x:Name="InstallUpdate" Content="Обновить и перезапустить" Visibility="Collapsed" Margin="0,0,0,8"/></WrapPanel></StackPanel></Border>
      <Border Background="{DynamicResource Surface}" CornerRadius="14" Padding="24" Margin="0,16,0,0"><StackPanel><TextBlock Text="Канал обновлений" FontSize="16" FontWeight="SemiBold"/><CheckBox x:Name="PreviewChannel" Content="Получать предварительные версии (RC)" Margin="0,14,0,8"/><TextBlock Text="При выключенном RC-канале доступны только стабильные выпуски. Проверка SHA-256 выполняется до замены приложения. Предыдущий EXE сохраняется рядом." Style="{StaticResource MutedText}"/></StackPanel></Border>
     </StackPanel></ScrollViewer>
     <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="760" HorizontalAlignment="Left">
      <Border Background="{DynamicResource Surface}" CornerRadius="14" Padding="24"><StackPanel><TextBlock Text="Работа приложения" FontSize="19" FontWeight="SemiBold"/><CheckBox x:Name="AutoCheck" Content="Проверять обновления при запуске" Margin="0,18,0,10"/><CheckBox x:Name="RestorePoint" Content="Запрашивать точку восстановления" Margin="0,8,0,10"/><TextBlock Text="Если Windows не сможет создать точку, причина появится в выводе. Исходные значения настроек сохраняются отдельно в журнале." Style="{StaticResource MutedText}"/></StackPanel></Border>
      <Border Background="{DynamicResource Surface}" CornerRadius="14" Padding="24" Margin="0,16,0,0"><StackPanel><TextBlock Text="Доступ к GitHub" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Для закрытого репозитория нужен fine-grained токен: выберите Lucky2356/wintools и разрешение Contents — Read-only. Для публичного репозитория токен не требуется." Style="{StaticResource MutedText}" Margin="0,12,0,14"/><PasswordBox x:Name="AccessToken" AutomationProperties.Name="Токен доступа GitHub"/><WrapPanel Margin="0,12,0,0"><Button x:Name="SaveAccess" Content="Сохранить доступ" Style="{StaticResource Primary}" Margin="0,0,10,8"/><Button x:Name="ClearAccess" Content="Удалить" Margin="0,0,10,8"/><Button x:Name="TokenHelp" Content="Создать токен ↗" Style="{StaticResource Ghost}"/></WrapPanel><TextBlock x:Name="AccessStatus" Style="{StaticResource MutedText}" FontSize="11"/><TextBlock Text="Токен шифруется средствами Windows для текущего пользователя. В журнал и отчёты он не записывается." Style="{StaticResource MutedText}" FontSize="11" Margin="0,8,0,0"/></StackPanel></Border>
      <Button x:Name="OpenData" Content="Открыть папку данных ↗" HorizontalAlignment="Left" Style="{StaticResource Ghost}" Margin="0,16,0,0"/>
     </StackPanel></ScrollViewer>
    </Grid>
    <Border Grid.Row="2" Background="{DynamicResource Surface}" CornerRadius="10" Margin="0,16,0,0"><DockPanel><Button x:Name="LogToggle" Content="Вывод операции  ▾" Style="{StaticResource Ghost}" DockPanel.Dock="Top" HorizontalContentAlignment="Left" Padding="14,8" MinHeight="34"/><TextBox x:Name="Output" IsReadOnly="True" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="100" Margin="0,0,0,8" Background="Transparent" BorderThickness="0" Visibility="Collapsed" Text="Результаты предпросмотра и выполнения появятся здесь."/></DockPanel></Border>
    <TextBlock x:Name="Status" Grid.Row="3" Text="Готово к работе" Foreground="{DynamicResource Muted}" FontSize="11" Margin="2,12,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
   </Grid>
  </Grid>
  <Grid x:Name="ConfirmOverlay" Background="#A0000000" Visibility="Collapsed"><Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="16" Width="480" Padding="28" VerticalAlignment="Center" HorizontalAlignment="Center"><StackPanel><TextBlock Text="Подтвердите действие" FontSize="24" FontWeight="SemiBold"/><ScrollViewer MaxHeight="300" Margin="0,18,0,24" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="ConfirmText" LineHeight="23"/></ScrollViewer><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="ConfirmNo" Content="Отмена"/><Button x:Name="ConfirmYes" Grid.Column="2" Content="Продолжить" Style="{StaticResource Primary}"/></Grid></StackPanel></Border></Grid>
 </Grid>
</Window>
