<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Wintools" Width="1280" Height="840" MinWidth="800" MinHeight="560" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Background}" Foreground="{DynamicResource Text}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Auto" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Window.Resources>
  <!-- Palette in the Windows 11 manner: the navigation sits on the window colour, pages on a slightly lighter layer, content on cards.
       NativeTheme.Colors replaces every brush at runtime for light, dark and high contrast. -->
  <SolidColorBrush x:Key="Background" Color="#1C1C1C"/>
  <SolidColorBrush x:Key="Sidebar" Color="#1C1C1C"/>
  <SolidColorBrush x:Key="Layer" Color="#232323"/>
  <SolidColorBrush x:Key="Surface" Color="#2B2B2B"/>
  <SolidColorBrush x:Key="Raised" Color="#343434"/>
  <SolidColorBrush x:Key="Border" Color="#3A3A3A"/>
  <SolidColorBrush x:Key="Text" Color="#F3F3F3"/>
  <SolidColorBrush x:Key="Muted" Color="#ABABAB"/>
  <SolidColorBrush x:Key="Accent" Color="#60CDFF"/>
  <SolidColorBrush x:Key="AccentText" Color="#04131C"/>
  <SolidColorBrush x:Key="Selection" Color="#2C3D46"/>
  <SolidColorBrush x:Key="Danger" Color="#FF99A4"/>
  <SolidColorBrush x:Key="Hover" Color="#323232"/>
  <SolidColorBrush x:Key="Success" Color="#6CCB5F"/>
  <SolidColorBrush x:Key="Warning" Color="#F5C84C"/>
  <SolidColorBrush x:Key="Scrim" Color="#99000000"/>
  <SolidColorBrush x:Key="Accent2" Color="#B9A3FF"/>
  <SolidColorBrush x:Key="NavSelected" Color="#2D2D2D"/>
  <SolidColorBrush x:Key="Divider" Color="#2F2F2F"/>
  <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#60CDFF" Offset="0"/><GradientStop Color="#B9A3FF" Offset="1"/></LinearGradientBrush>

  <!-- Layout values changed by AdaptLayout. -->
  <sys:Double x:Key="NavItemHeight">36</sys:Double>
  <!-- Larger text zooms the whole window; pop-ups have their own windows and read the same zoom from here. -->
  <ScaleTransform x:Key="UiZoom" ScaleX="1" ScaleY="1"/>
  <sys:Int32 x:Key="BrowseColumns">2</sys:Int32>
  <sys:Double x:Key="CatalogueItemWidth">NaN</sys:Double>
  <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>

  <!-- Text: the Windows 11 type ramp (caption 12, body 14, subtitle 20, title 28). -->
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="MutedText" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="20"/>
  </Style>
  <Style x:Key="SectionLabel" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,6"/>
  </Style>
  <Style x:Key="CardTitle" TargetType="TextBlock">
   <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="Icon" TargetType="TextBlock">
   <Setter Property="FontFamily" Value="{StaticResource IconFont}"/><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="NavHeader" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Margin" Value="14,16,0,6"/><Setter Property="Visibility" Value="{DynamicResource NavHeaderVisibility}"/>
  </Style>
  <Style x:Key="NavSeparator" TargetType="Border">
   <Setter Property="Height" Value="1"/><Setter Property="Background" Value="{DynamicResource Divider}"/><Setter Property="Margin" Value="10,6"/>
   <Setter Property="Visibility" Value="{DynamicResource NavSeparatorVisibility}"/>
  </Style>
  <Style x:Key="Card" TargetType="Border">
   <Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="20"/>
  </Style>

  <!-- Buttons: a translucent state layer keeps hover and press visible on every background; the focus ring sits outside the control. -->
  <ControlTemplate x:Key="ButtonChrome" TargetType="Button">
   <Grid>
    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"/>
    <Border x:Name="State" Background="{TemplateBinding Foreground}" CornerRadius="4" Opacity="0"/>
    <Border x:Name="Focus" BorderBrush="{DynamicResource Text}" BorderThickness="2" CornerRadius="6" Margin="-3" Visibility="Collapsed"/>
    <ContentPresenter x:Name="Content" Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="State" Property="Opacity" Value="0.07"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="State" Property="Opacity" Value="0.03"/><Setter TargetName="Content" Property="Opacity" Value="0.75"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="Visibility" Value="Visible"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style TargetType="Button">
   <Setter Property="Background" Value="{DynamicResource Raised}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="14,6"/><Setter Property="MinHeight" Value="34"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template" Value="{StaticResource ButtonChrome}"/>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Style.Triggers>
    <!-- A disabled main button turns neutral so it never reads as available. -->
    <Trigger Property="IsEnabled" Value="False">
     <Setter Property="Background" Value="{DynamicResource Raised}"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="FontWeight" Value="Normal"/>
    </Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Text}"/>
  </Style>
  <Style x:Key="Link" TargetType="Button" BasedOn="{StaticResource Ghost}">
   <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
  </Style>
  <!-- Large clickable cards: section tiles, scenarios and shortcuts. -->
  <Style x:Key="Tile" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="18,16"/><Setter Property="Margin" Value="0,0,12,12"/><Setter Property="FontWeight" Value="Normal"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid>
     <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"/>
     <Border x:Name="State" Background="{TemplateBinding Foreground}" CornerRadius="8" Opacity="0"/>
     <Border x:Name="Focus" BorderBrush="{DynamicResource Text}" BorderThickness="2" CornerRadius="10" Margin="-3" Visibility="Collapsed"/>
     <ContentPresenter x:Name="Content" Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="State" Property="Opacity" Value="0.05"/><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Muted}"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="State" Property="Opacity" Value="0.02"/><Setter TargetName="Content" Property="Opacity" Value="0.8"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- Navigation: Tag holds the icon glyph, BorderBrush draws the active pill. -->
  <Style x:Key="Nav" TargetType="Button">
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Text}"/>
   <Setter Property="Padding" Value="12,0"/><Setter Property="Margin" Value="0,1"/><Setter Property="MinHeight" Value="{DynamicResource NavItemHeight}"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid Background="Transparent">
     <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="5"/>
     <Border x:Name="State" Background="{DynamicResource Text}" CornerRadius="5" Opacity="0"/>
     <Border x:Name="Focus" BorderBrush="{DynamicResource Text}" BorderThickness="2" CornerRadius="5" Visibility="Collapsed"/>
     <Border Background="{TemplateBinding BorderBrush}" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" VerticalAlignment="Center"/>
     <Grid Margin="{TemplateBinding Padding}" VerticalAlignment="Center">
      <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="Glyph" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="{StaticResource IconFont}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="NoWrap"/>
      <ContentPresenter Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Visibility="{DynamicResource NavLabelVisibility}" TextElement.FontWeight="Normal"/>
     </Grid>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="State" Property="Opacity" Value="0.05"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="State" Property="Opacity" Value="0.03"/></Trigger>
     <Trigger Property="Tag" Value="{x:Null}"><Setter TargetName="Glyph" Property="Visibility" Value="Collapsed"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- The search field at the top of the navigation: a button that looks like a text box and opens the search everywhere. -->
  <Style x:Key="SearchField" TargetType="Button">
   <Setter Property="Background" Value="{DynamicResource Layer}"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
   <Setter Property="MinHeight" Value="34"/><Setter Property="Cursor" Value="IBeam"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid>
     <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4"/>
     <Border x:Name="Focus" BorderBrush="{DynamicResource Text}" BorderThickness="2" CornerRadius="6" Margin="-3" Visibility="Collapsed"/>
     <Grid Margin="11,0,10,0" VerticalAlignment="Center">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" TextWrapping="NoWrap"/>
      <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="{DynamicResource NavLabelVisibility}"/>
      <Border Grid.Column="2" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="3" Padding="5,0,5,1" VerticalAlignment="Center" Visibility="{DynamicResource NavLabelVisibility}">
       <TextBlock Text="Ctrl+K" FontSize="11" TextWrapping="NoWrap"/>
      </Border>
     </Grid>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Muted}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="Visibility" Value="Visible"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Inputs: a hairline frame with a stronger bottom edge that turns into the accent underline while typing. -->
  <Style TargetType="TextBox">
   <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource Raised}"/>
   <Setter Property="CaretBrush" Value="{DynamicResource Text}"/><Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="10,6"/><Setter Property="MinHeight" Value="34"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
    <Grid>
     <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
      <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
     </Border>
     <Border x:Name="Edge" BorderBrush="{DynamicResource Muted}" BorderThickness="0,0,0,1" CornerRadius="4" Opacity="0.55" IsHitTestVisible="False"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True">
      <Setter TargetName="Frame" Property="Background" Value="{DynamicResource Layer}"/>
      <Setter TargetName="Edge" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Edge" Property="BorderThickness" Value="0,0,0,2"/><Setter TargetName="Edge" Property="Opacity" Value="1"/>
     </Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="PasswordBox">
   <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource Raised}"/>
   <Setter Property="CaretBrush" Value="{DynamicResource Text}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="Padding" Value="10,6"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox">
    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4"><ScrollViewer x:Name="PART_ContentHost" Margin="0"/></Border>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- Toggle switch in the Windows 11 manner. -->
  <Style TargetType="CheckBox">
   <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,8,18,8"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <Grid Background="Transparent">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border x:Name="Track" Width="40" Height="20" CornerRadius="10" Background="Transparent" BorderBrush="{DynamicResource Muted}" BorderThickness="1" VerticalAlignment="Center">
      <Ellipse x:Name="Knob" Fill="{DynamicResource Muted}" Width="12" Height="12" HorizontalAlignment="Left" Margin="4,0"/>
     </Border>
     <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource Hover}"/><Setter TargetName="Knob" Property="Width" Value="14"/><Setter TargetName="Knob" Property="Height" Value="14"/><Setter TargetName="Knob" Property="Margin" Value="3,0"/></Trigger>
     <Trigger Property="IsChecked" Value="True">
      <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent}"/>
      <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Knob" Property="Fill" Value="{DynamicResource AccentText}"/>
      <Setter TargetName="Knob" Property="Width" Value="14"/><Setter TargetName="Knob" Property="Height" Value="14"/><Setter TargetName="Knob" Property="Margin" Value="3,0"/>
     </Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Text}"/><Setter TargetName="Track" Property="BorderThickness" Value="2"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- Square checkbox for "select for the action" lists; switches stay for settings that act at once. -->
  <Style x:Key="Tick" TargetType="CheckBox">
   <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,8,18,8"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <Grid Background="Transparent">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border x:Name="Box" Width="20" Height="20" CornerRadius="4" Background="Transparent" BorderBrush="{DynamicResource Muted}" BorderThickness="1" VerticalAlignment="Top" Margin="0,1,0,0">
      <TextBlock x:Name="Mark" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
     </Border>
     <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
     <Trigger Property="IsChecked" Value="True">
      <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
      <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
     </Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Text}"/><Setter TargetName="Box" Property="BorderThickness" Value="2"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- Filter chips: a CheckBox shown as a rounded pill, used where several filters sit in one row. -->
  <Style x:Key="Chip" TargetType="CheckBox">
   <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,4,8,4"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <Border x:Name="Pill" Background="{DynamicResource Raised}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="15" Padding="12,4" MinHeight="30">
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <TextBlock x:Name="Mark" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{DynamicResource AccentText}" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="Collapsed"/>
      <ContentPresenter x:Name="Label" VerticalAlignment="Center" RecognizesAccessKey="True"/>
     </StackPanel>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource Muted}"/></Trigger>
     <Trigger Property="IsChecked" Value="True">
      <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource Accent}"/>
      <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource AccentText}"/>
      <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
     </Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource Text}"/><Setter TargetName="Pill" Property="BorderThickness" Value="2"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- Page tabs: plain text with the accent pill under the chosen one, like the selector bar of Windows 11 apps. -->
  <Style x:Key="Tab" TargetType="CheckBox">
   <Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,4,0"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <Grid Background="Transparent" MinHeight="40">
     <Border x:Name="Back" CornerRadius="5" Margin="0,2,0,6"/>
     <ContentPresenter Margin="12,0,12,4" VerticalAlignment="Center" RecognizesAccessKey="True"/>
     <Border x:Name="Bar" Height="3" Width="18" CornerRadius="1.5" Background="{DynamicResource Accent}" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,2" Visibility="Hidden"/>
     <Border x:Name="Focus" BorderBrush="{DynamicResource Text}" BorderThickness="2" CornerRadius="5" Visibility="Collapsed"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Back" Property="Background" Value="{DynamicResource Hover}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter TargetName="Bar" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
   <Setter Property="Padding" Value="12,7"/><Setter Property="Foreground" Value="{DynamicResource Text}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
    <Grid Margin="0,1">
     <Border x:Name="Frame" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
     <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" Background="{DynamicResource Accent}" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource Hover}"/><Setter TargetName="Pill" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource Raised}"/>
   <Setter Property="MinHeight" Value="34"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
    <Grid>
     <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
      <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
       <Grid>
        <Border x:Name="Frame" Background="{DynamicResource Raised}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4"/>
        <Border x:Name="State" Background="{DynamicResource Text}" CornerRadius="4" Opacity="0"/>
        <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
       </Grid>
       <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="State" Property="Opacity" Value="0.05"/></Trigger>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="State" Property="Opacity" Value="0.03"/></Trigger>
       </ControlTemplate.Triggers>
      </ControlTemplate></ToggleButton.Template>
     </ToggleButton>
     <ContentPresenter Margin="12,0,32,0" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
     <Border x:Name="Focus" BorderBrush="{DynamicResource Text}" BorderThickness="2" CornerRadius="6" Margin="-3" Visibility="Collapsed" IsHitTestVisible="False"/>
     <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="2" HorizontalOffset="-8" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" PopupAnimation="Fade">
      <Grid Margin="8,0,8,12" LayoutTransform="{DynamicResource UiZoom}" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="360">
       <Border Background="{DynamicResource Surface}" CornerRadius="8">
        <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="5" Direction="270" Opacity="0.28" Color="Black"/></Border.Effect>
       </Border>
       <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="4">
        <ScrollViewer><ItemsPresenter/></ScrollViewer>
       </Border>
      </Grid>
     </Popup>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Lists: rows are separate cards with a small gap; the chosen row gets the accent tint and pill. -->
  <Style TargetType="ListBox">
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  </Style>
  <Style TargetType="ListBoxItem">
   <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Margin" Value="0,0,6,4"/><Setter Property="Padding" Value="16,11"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Grid>
     <Border x:Name="Card" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
     <Border x:Name="Pill" Width="3" Height="18" CornerRadius="1.5" Background="{DynamicResource Accent}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0" Visibility="Collapsed"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="Background" Value="{DynamicResource Selection}"/><Setter TargetName="Pill" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Text}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Thin scroll bars for both orientations. -->
  <ControlTemplate x:Key="ScrollThumb" TargetType="Thumb">
   <Border x:Name="Bar" Background="{DynamicResource Muted}" Opacity="0.45" CornerRadius="3" Margin="3"/>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bar" Property="Opacity" Value="0.8"/></Trigger>
    <Trigger Property="IsDragging" Value="True"><Setter TargetName="Bar" Property="Opacity" Value="0.9"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style TargetType="ScrollBar">
   <Setter Property="Background" Value="Transparent"/><Setter Property="Width" Value="12"/><Setter Property="MinWidth" Value="12"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
    <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
     <Track.Thumb><Thumb MinHeight="28" Template="{StaticResource ScrollThumb}"/></Track.Thumb>
     <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
     <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
    </Track>
   </ControlTemplate></Setter.Value></Setter>
   <Style.Triggers>
    <Trigger Property="Orientation" Value="Horizontal">
     <Setter Property="Width" Value="Auto"/><Setter Property="MinWidth" Value="0"/><Setter Property="Height" Value="12"/><Setter Property="MinHeight" Value="12"/>
     <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
      <Track x:Name="PART_Track" IsDirectionReversed="False" Orientation="Horizontal">
       <Track.Thumb><Thumb MinWidth="28" Template="{StaticResource ScrollThumb}"/></Track.Thumb>
       <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
       <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
      </Track>
     </ControlTemplate></Setter.Value></Setter>
    </Trigger>
   </Style.Triggers>
  </Style>

  <Style TargetType="ProgressBar">
   <Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter Property="Background" Value="{DynamicResource Border}"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="Height" Value="4"/>
  </Style>

  <!-- Expanders used by hardware, measurement, memory and temperature sections. -->
  <Style TargetType="Expander">
   <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8">
     <DockPanel>
      <ToggleButton x:Name="HeaderSite" DockPanel.Dock="Top" Cursor="Hand" Focusable="True" FocusVisualStyle="{x:Null}" Foreground="{TemplateBinding Foreground}"
                    Content="{TemplateBinding Header}" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
       <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
        <Border x:Name="Row" Background="Transparent" CornerRadius="8" Padding="18,14">
         <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <ContentPresenter ContentSource="Content" TextElement.FontWeight="SemiBold" TextElement.FontSize="15" VerticalAlignment="Center"/>
          <Border x:Name="Knob" Grid.Column="1" Width="30" Height="30" CornerRadius="4" Margin="12,0,0,0">
           <TextBlock x:Name="Chevron" Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
         </Grid>
        </Border>
        <ControlTemplate.Triggers>
         <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Knob" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
         <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="Text" Value="&#xE70E;"/></Trigger>
         <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
        </ControlTemplate.Triggers>
       </ControlTemplate></ToggleButton.Template>
      </ToggleButton>
      <ContentPresenter x:Name="ExpandSite" Margin="18,0,18,16" Visibility="Collapsed"/>
     </DockPanel>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <Style TargetType="ToolTip">
   <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="MaxWidth" Value="460"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip">
    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6" Padding="10,7" LayoutTransform="{DynamicResource UiZoom}">
     <ContentPresenter TextElement.FontSize="13">
      <ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></ContentPresenter.Resources>
     </ContentPresenter>
    </Border>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <Style x:Key="FlatMenuItem" TargetType="MenuItem">
   <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Padding" Value="12,7"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
    <Border x:Name="Chrome" Padding="{TemplateBinding Padding}" Background="Transparent" CornerRadius="4" Margin="0,1"><ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="FlatMenu" TargetType="ContextMenu">
   <Setter Property="ItemContainerStyle" Value="{StaticResource FlatMenuItem}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="4" LayoutTransform="{DynamicResource UiZoom}"><StackPanel IsItemsHost="True"/></Border>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>

 <Grid>
  <Grid x:Name="Body" Background="{DynamicResource Background}">
   <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

   <!-- Navigation pane on the window colour, as in Windows 11 Settings. -->
   <Border x:Name="Sidebar" Background="{DynamicResource Sidebar}" Padding="10,14,10,10">
    <DockPanel>
     <Grid x:Name="Brand" DockPanel.Dock="Top" Margin="8,0,0,14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="{DynamicResource AccentGradient}" CornerRadius="7" Width="30" Height="30">
       <Viewbox Margin="7"><Path Data="M 0,0 L 4,18 L 9,9 L 14,18 L 18,0" Stroke="{DynamicResource AccentText}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Viewbox>
      </Border>
      <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{DynamicResource NavLabelVisibility}">
       <TextBlock Text="Wintools" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="16" TextWrapping="NoWrap"/>
       <TextBlock Text="Windows под контролем" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="NoWrap"/>
      </StackPanel>
     </Grid>
     <Button x:Name="NavSearch" DockPanel.Dock="Top" Content="Поиск" ToolTip="Поиск по разделам, настройкам, службам и программам · Ctrl+K" AutomationProperties.Name="Поиск везде" Style="{StaticResource SearchField}" Margin="2,0,2,10"/>
     <StackPanel x:Name="SidebarFooter" DockPanel.Dock="Bottom" Margin="0,8,0,0">
      <Border Height="1" Background="{DynamicResource Divider}" Margin="10,0,10,8"/>
      <TextBlock x:Name="VersionLabel" Style="{StaticResource MutedText}" FontSize="11" Margin="14,0,0,2"/>
      <TextBlock Text="Portable · без установки и фоновых служб" Style="{StaticResource MutedText}" FontSize="11" LineHeight="16" Margin="14,0,0,4"/>
      <Button x:Name="ReleaseLink" Content="Выпуски на GitHub ↗" Style="{StaticResource Link}" FontSize="12" Padding="14,4" MinHeight="28" HorizontalAlignment="Left"/>
     </StackPanel>
     <ScrollViewer x:Name="NavScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
       <TextBlock Text="Обзор" Style="{StaticResource NavHeader}" Margin="14,2,0,6"/>
       <Button x:Name="NavHome" Content="Главная" ToolTip="Главная" Tag="&#xE80F;" Style="{StaticResource Nav}"/>
       <Button x:Name="Diagnose" Content="Состояние ПК" ToolTip="Состояние ПК" Tag="&#xE9D9;" Style="{StaticResource Nav}"/>
       <Button x:Name="NavOptimize" Content="Ускорение Windows" ToolTip="Ускорение Windows" Tag="&#xE945;" Style="{StaticResource Nav}"/>
       <TextBlock Text="Настройка Windows" Style="{StaticResource NavHeader}"/>
       <Border Style="{StaticResource NavSeparator}"/>
       <Button x:Name="NavCatalogue" Content="Каталог настроек" ToolTip="Каталог настроек" Tag="&#xE8F1;" Style="{StaticResource Nav}"/>
       <Button x:Name="NavCollections" Content="Подборки" ToolTip="Подборки" Tag="&#xE734;" Style="{StaticResource Nav}"/>
       <Button x:Name="NavPlan" Content="План изменений" ToolTip="План изменений" Tag="&#xE8FD;" Style="{StaticResource Nav}"/>
       <Button x:Name="NavHistory" Content="История и откат" ToolTip="История и откат" Tag="&#xE81C;" Style="{StaticResource Nav}"/>
       <Button x:Name="Verify" Content="Сверка настроек" ToolTip="Сверка настроек" Tag="&#xE73E;" Style="{StaticResource Nav}"/>
       <TextBlock Text="Инструменты" Style="{StaticResource NavHeader}"/>
       <Border Style="{StaticResource NavSeparator}"/>
       <Button x:Name="NavApplications" Content="Приложения" ToolTip="Приложения" Tag="&#xE71D;" Style="{StaticResource Nav}"/>
       <Button x:Name="NavPackages" Content="Установка программ" ToolTip="Установка программ" Tag="&#xE896;" Style="{StaticResource Nav}"/>
       <Button x:Name="NavIntegrity" Content="Обслуживание" ToolTip="Обслуживание" Tag="&#xE90F;" Style="{StaticResource Nav}"/>
       <Button x:Name="NavNetwork" Content="Сеть и DNS" ToolTip="Сеть и DNS" Tag="&#xE701;" Style="{StaticResource Nav}"/>
       <!-- Expert tools stay one click away but out of a newcomer's first glance; ShowPage opens the group for its own pages. -->
       <Button x:Name="AdvancedToggle" Content="Для опытных  ▾" ToolTip="Автозагрузка, процессы и службы" Tag="&#xE7EF;" Style="{StaticResource Nav}"/>
       <StackPanel x:Name="AdvancedNav" Visibility="Collapsed">
        <Button x:Name="NavStartup" Content="Автозагрузка" ToolTip="Автозагрузка" Tag="&#xE768;" Style="{StaticResource Nav}" Padding="24,0,12,0"/>
        <Button x:Name="NavProcesses" Content="Процессы" ToolTip="Процессы" Tag="&#xE7C4;" Style="{StaticResource Nav}" Padding="24,0,12,0"/>
        <Button x:Name="NavServices" Content="Службы" ToolTip="Службы" Tag="&#xE713;" Style="{StaticResource Nav}" Padding="24,0,12,0"/>
       </StackPanel>
       <Border Height="1" Background="{DynamicResource Divider}" Margin="10,7"/>
       <Button x:Name="NavSettings" Content="Настройки" ToolTip="Настройки" Tag="&#xE115;" Style="{StaticResource Nav}"/>
      </StackPanel>
     </ScrollViewer>
    </DockPanel>
   </Border>

   <!-- Pages lie on a lighter layer with a rounded inner corner; the status bar runs along its bottom edge. -->
   <Border x:Name="Layer" Grid.Column="1" Background="{DynamicResource Layer}" BorderBrush="{DynamicResource Divider}" BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid x:Name="Workspace" Margin="36,26,36,14">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel x:Name="PageHeader" Margin="0,0,0,20">
     <TextBlock x:Name="PageTitle" Text="Windows под ваши задачи" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
     <TextBlock x:Name="PageHint" Text="Понятные действия. Предпросмотр. Контролируемый откат." Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
    </StackPanel>
    <Grid x:Name="Pages" Grid.Row="1">
     <!-- Catalogue -->
     <Grid x:Name="CataloguePage">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
       <Grid Margin="0,0,10,0">
        <TextBox x:Name="Search" AutomationProperties.Name="Поиск действий" Height="40" Padding="34,0,10,0"/>
        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource Muted}" Margin="13,0,0,0" IsHitTestVisible="False"/>
        <TextBlock x:Name="SearchHint" Text="Поиск по названию, описанию или ID · Ctrl+K — поиск везде" Foreground="{DynamicResource Muted}" Margin="36,0,10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" IsHitTestVisible="False"/>
       </Grid>
       <ComboBox x:Name="Category" Grid.Column="1" MinHeight="40" DisplayMemberPath="Value" SelectedValuePath="Key" AutomationProperties.Name="Категория"/>
      </Grid>
      <Grid Grid.Row="1" Margin="0,10,0,12">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <WrapPanel VerticalAlignment="Center">
        <Button x:Name="BackToGroups" Content="← Разделы" Style="{StaticResource Ghost}" Padding="10,4" MinHeight="30" Margin="0,0,8,0"/>
        <Button x:Name="RefreshCatalogueServices" Content="↻ Состояние" ToolTip="Повторно прочитать текущее состояние настроек и служб Windows" Visibility="Collapsed" Style="{StaticResource Ghost}" Padding="10,4" MinHeight="30" Margin="0,0,8,0"/>
        <CheckBox x:Name="Favorites" Content="Избранное" Style="{StaticResource Chip}"/>
        <CheckBox x:Name="Risky" Content="Высокий риск" Style="{StaticResource Chip}"/>
        <CheckBox x:Name="HideApplied" Content="Скрыть применённые" Style="{StaticResource Chip}" ToolTip="Не показывать действия, которые уже действуют в Windows"/>
        <Button x:Name="ClearCollection" Content="Подборка ×" ToolTip="Показать все действия, а не только выбранные в подборке" Visibility="Collapsed" Style="{StaticResource Link}" Padding="10,4" MinHeight="30"/>
       </WrapPanel>
       <TextBlock x:Name="Count" Grid.Column="1" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" TextWrapping="NoWrap"/>
      </Grid>
      <ScrollViewer x:Name="CatalogueGroups" Grid.Row="2" VerticalScrollBarVisibility="Auto">
       <StackPanel>
        <DockPanel Margin="0,0,0,14">
         <Button x:Name="ShowAll" Content="Все действия →" Style="{StaticResource Link}" DockPanel.Dock="Right"/>
         <TextBlock x:Name="BrowseTitle" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>
        <ItemsControl x:Name="BrowseGroups">
         <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{DynamicResource BrowseColumns}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
         <ItemsControl.ItemTemplate><DataTemplate>
          <Button Tag="{Binding Key}" Style="{StaticResource Tile}">
           <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid Width="42" Height="42" VerticalAlignment="Center" Margin="0,0,14,0">
             <Border x:Name="Tint" CornerRadius="6" Background="{DynamicResource Accent}" Opacity="0.15"/>
             <TextBlock x:Name="Glyph" Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="19" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="NoWrap"/>
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
             <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"/>
             <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Muted}" FontSize="13" Margin="0,4,0,0"/>
            </StackPanel>
            <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0"/>
           </Grid>
          </Button>
          <DataTemplate.Triggers>
           <DataTrigger Binding="{Binding Tint}" Value="violet"><Setter TargetName="Tint" Property="Background" Value="{DynamicResource Accent2}"/><Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Accent2}"/></DataTrigger>
           <DataTrigger Binding="{Binding Tint}" Value="green"><Setter TargetName="Tint" Property="Background" Value="{DynamicResource Success}"/><Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Success}"/></DataTrigger>
           <DataTrigger Binding="{Binding Tint}" Value="amber"><Setter TargetName="Tint" Property="Background" Value="{DynamicResource Warning}"/><Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Warning}"/></DataTrigger>
          </DataTemplate.Triggers>
         </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
       </StackPanel>
      </ScrollViewer>
      <Grid x:Name="CatalogueResults" Grid.Row="2">
       <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="1*" MinWidth="280"/></Grid.ColumnDefinitions>
       <Grid>
        <ListBox x:Name="Items" AutomationProperties.Name="Действия">
         <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemWidth="{DynamicResource CatalogueItemWidth}"/></ItemsPanelTemplate></ListBox.ItemsPanel>
         <ListBox.ItemTemplate><DataTemplate>
          <Grid>
           <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
           <Grid x:Name="Badge" Width="38" Height="38" VerticalAlignment="Top" Margin="0,1,14,0">
            <Border x:Name="Tint" CornerRadius="6" Background="{DynamicResource Accent}" Opacity="0.15"/>
            <TextBlock x:Name="Glyph" Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="17" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="NoWrap"/>
           </Grid>
           <StackPanel Grid.Column="1">
            <TextBlock Text="{Binding DisplayTitle}" ToolTip="{Binding DisplayTitle}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="42" LineHeight="21" LineStackingStrategy="BlockLineHeight"/>
            <DockPanel Margin="0,5,0,0" LastChildFill="True">
             <Border x:Name="Risk" DockPanel.Dock="Left" BorderBrush="{DynamicResource Success}" BorderThickness="1" CornerRadius="9" Padding="8,1" Margin="0,0,8,0" VerticalAlignment="Center">
              <TextBlock x:Name="RiskText" Text="{Binding RiskText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Success}" TextWrapping="NoWrap"/>
             </Border>
             <TextBlock Text="{Binding Group}" Foreground="{DynamicResource Muted}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
            </DockPanel>
            <TextBlock x:Name="State" Text="{Binding ServiceStatus}" Visibility="{Binding ServiceVisibility}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
           </StackPanel>
          </Grid>
          <DataTemplate.Triggers>
           <DataTrigger Binding="{Binding ShowIcon}" Value="False"><Setter TargetName="Badge" Property="Visibility" Value="Collapsed"/></DataTrigger>
           <DataTrigger Binding="{Binding Tint}" Value="violet"><Setter TargetName="Tint" Property="Background" Value="{DynamicResource Accent2}"/><Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Accent2}"/></DataTrigger>
           <DataTrigger Binding="{Binding Tint}" Value="green"><Setter TargetName="Tint" Property="Background" Value="{DynamicResource Success}"/><Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Success}"/></DataTrigger>
           <DataTrigger Binding="{Binding Tint}" Value="amber"><Setter TargetName="Tint" Property="Background" Value="{DynamicResource Warning}"/><Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Warning}"/></DataTrigger>
           <DataTrigger Binding="{Binding RiskLevel}" Value="med"><Setter TargetName="Risk" Property="BorderBrush" Value="{DynamicResource Warning}"/><Setter TargetName="RiskText" Property="Foreground" Value="{DynamicResource Warning}"/></DataTrigger>
           <DataTrigger Binding="{Binding RiskLevel}" Value="high"><Setter TargetName="Risk" Property="BorderBrush" Value="{DynamicResource Danger}"/><Setter TargetName="RiskText" Property="Foreground" Value="{DynamicResource Danger}"/></DataTrigger>
           <DataTrigger Binding="{Binding Applied}" Value="True"><Setter TargetName="State" Property="Foreground" Value="{DynamicResource Success}"/></DataTrigger>
          </DataTemplate.Triggers>
         </DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <StackPanel x:Name="EmptyCatalogue" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="22">
         <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="28" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center"/>
         <TextBlock Text="Ничего не найдено" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0"/>
         <TextBlock Text="Измените запрос или отключите фильтры." Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,6,0,0"/>
        </StackPanel>
       </Grid>
       <Border x:Name="ActionCard" Grid.Column="2" Style="{StaticResource Card}" Padding="22,20">
        <DockPanel>
         <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
          <Grid>
           <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
           <Button x:Name="Apply" Content="Применить" ToolTip="Применить выбранное действие" Style="{StaticResource Primary}" Padding="8,8"/>
           <Button x:Name="Preview" Grid.Column="2" Content="Предпросмотр" ToolTip="Показать изменения без применения" Padding="8,8"/>
          </Grid>
          <Grid Margin="0,6,0,0">
           <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
           <Button x:Name="Revert" Content="Откатить" Padding="4,6" MinHeight="34"/>
           <Button x:Name="Star" Grid.Column="1" Content="☆" ToolTip="Избранное" AutomationProperties.Name="Избранное" Style="{StaticResource Ghost}" Padding="4,6" MinHeight="32" FontSize="16"/>
           <Button x:Name="PlanAdd" Grid.Column="2" Content="В план +" ToolTip="Добавить в план изменений; очистка и удаление Edge выполняются отдельно" Padding="4,6" MinHeight="34"/>
          </Grid>
         </StackPanel>
         <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
           <StackPanel>
            <TextBlock x:Name="ActionLabel" Text="Выбранное действие" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
            <TextBlock x:Name="ActionTitle" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock x:Name="Metadata" Style="{StaticResource MutedText}" FontSize="13" Margin="0,6,0,14"/>
           </StackPanel>
           <TextBlock Text="Что изменится" Style="{StaticResource SectionLabel}"/>
           <TextBlock x:Name="Description" LineHeight="23" Margin="0,0,0,4"/>
           <TextBlock Text="На что обратить внимание" Style="{StaticResource SectionLabel}" Margin="0,16,0,6"/>
           <TextBlock x:Name="Caveat" LineHeight="23"/>
           <TextBlock x:Name="Compatibility" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
           <Border Height="1" Background="{DynamicResource Border}" Margin="0,16"/>
           <TextBlock Text="Возможность отката" Style="{StaticResource SectionLabel}"/>
           <TextBlock x:Name="Rollback" Style="{StaticResource MutedText}"/>
          </StackPanel>
         </ScrollViewer>
        </DockPanel>
       </Border>
      </Grid>
     </Grid>

     <!-- Plan -->
     <Grid x:Name="PlanPage" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,6,12">
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" Foreground="{DynamicResource Accent}" Margin="0,0,12,0"/>
        <TextBlock x:Name="PlanStatus" Grid.Column="1" Style="{StaticResource MutedText}"/>
       </Grid>
      </Border>
      <StackPanel x:Name="EmptyPlan" Grid.Row="1" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440" Margin="22">
       <Border Width="72" Height="72" CornerRadius="36" Background="{DynamicResource Selection}" HorizontalAlignment="Center">
        <TextBlock Text="&#xE8FD;" Style="{StaticResource Icon}" FontSize="30" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/>
       </Border>
       <TextBlock Text="План пока пуст" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,0"/>
       <TextBlock Text="Откройте действие в каталоге и нажмите «В план +». Так можно собрать несколько изменений, проверить их предпросмотром и выполнить за один раз." Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,8,0,16"/>
       <Button x:Name="EmptyPlanOpen" Content="Открыть каталог →" Style="{StaticResource Primary}" HorizontalAlignment="Center"/>
      </StackPanel>
      <ListBox x:Name="PlanItems" Grid.Row="1" AutomationProperties.Name="План изменений">
       <ListBox.ItemTemplate><DataTemplate>
        <StackPanel>
         <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" FontSize="15"/>
         <DockPanel Margin="0,6,0,0">
          <Border x:Name="Risk" DockPanel.Dock="Left" BorderBrush="{DynamicResource Success}" BorderThickness="1" CornerRadius="9" Padding="8,1" Margin="0,0,10,0" VerticalAlignment="Top">
           <TextBlock x:Name="RiskText" Text="{Binding RiskText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Success}" TextWrapping="NoWrap"/>
          </Border>
          <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource Muted}" LineHeight="21" TextWrapping="Wrap"/>
         </DockPanel>
        </StackPanel>
        <DataTemplate.Triggers>
         <DataTrigger Binding="{Binding RiskLevel}" Value="med"><Setter TargetName="Risk" Property="BorderBrush" Value="{DynamicResource Warning}"/><Setter TargetName="RiskText" Property="Foreground" Value="{DynamicResource Warning}"/></DataTrigger>
         <DataTrigger Binding="{Binding RiskLevel}" Value="high"><Setter TargetName="Risk" Property="BorderBrush" Value="{DynamicResource Danger}"/><Setter TargetName="RiskText" Property="Foreground" Value="{DynamicResource Danger}"/></DataTrigger>
        </DataTemplate.Triggers>
       </DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <Grid Grid.Row="2" Margin="0,12,0,0">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <WrapPanel>
        <Button x:Name="PlanUp" Content="↑ Выше" ToolTip="Переместить выбранное действие выше" Margin="0,0,6,8"/>
        <Button x:Name="PlanDown" Content="↓ Ниже" ToolTip="Переместить выбранное действие ниже" Margin="0,0,6,8"/>
        <Button x:Name="PlanRemove" Content="Убрать из плана" Margin="0,0,12,8"/>
        <Button x:Name="ProfileImport" Content="Загрузить профиль" Style="{StaticResource Ghost}" Margin="0,0,4,8"/>
        <Button x:Name="ProfileExport" Content="Сохранить профиль" Style="{StaticResource Ghost}" Margin="0,0,4,8"/>
       </WrapPanel>
       <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
        <Button x:Name="PlanStop" Content="Остановить после действия" Visibility="Collapsed" Margin="0,0,8,8"/>
        <Button x:Name="PlanPreview" Content="Предпросмотр плана" Margin="0,0,8,8"/>
        <Button x:Name="PlanApply" Content="Выполнить план" Style="{StaticResource Primary}" Margin="0,0,0,8"/>
       </WrapPanel>
      </Grid>
     </Grid>

     <!-- History -->
     <Grid x:Name="HistoryPage" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,6,12">
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Text="&#xE81C;" Style="{StaticResource Icon}" Foreground="{DynamicResource Accent}" Margin="0,0,12,0"/>
        <TextBlock x:Name="HistoryStatus" Grid.Column="1" Style="{StaticResource MutedText}"/>
       </Grid>
      </Border>
      <StackPanel x:Name="EmptyHistory" Grid.Row="1" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440" Margin="22">
       <Border Width="72" Height="72" CornerRadius="36" Background="{DynamicResource Selection}" HorizontalAlignment="Center">
        <TextBlock Text="&#xE81C;" Style="{StaticResource Icon}" FontSize="30" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/>
       </Border>
       <TextBlock Text="Изменений пока нет" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,0"/>
       <TextBlock Text="Когда вы примените настройку, здесь появится запись. Любое изменение можно будет откатить к прежнему состоянию." Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,8,0,16"/>
       <Button x:Name="EmptyHistoryHome" Content="На главную →" Style="{StaticResource Primary}" HorizontalAlignment="Center"/>
      </StackPanel>
      <ListBox x:Name="History" Grid.Row="1" AutomationProperties.Name="История запусков">
       <ListBox.ItemTemplate><DataTemplate>
        <StackPanel>
         <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
         <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,4,0,0"/>
         <TextBlock x:Name="Outcome" Text="{Binding Status}" Margin="0,4,0,0" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Success}"/>
        </StackPanel>
        <DataTemplate.Triggers>
         <DataTrigger Binding="{Binding Tone}" Value="Danger"><Setter TargetName="Outcome" Property="Foreground" Value="{DynamicResource Danger}"/></DataTrigger>
         <DataTrigger Binding="{Binding Tone}" Value="Warning"><Setter TargetName="Outcome" Property="Foreground" Value="{DynamicResource Warning}"/></DataTrigger>
         <DataTrigger Binding="{Binding Tone}" Value="Muted"><Setter TargetName="Outcome" Property="Foreground" Value="{DynamicResource Muted}"/></DataTrigger>
        </DataTemplate.Triggers>
       </DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <Grid Grid.Row="2" Margin="0,12,0,0">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <WrapPanel>
        <Button x:Name="RefreshHistory" Content="↻ Обновить" Style="{StaticResource Ghost}" Margin="0,0,4,8"/>
        <Button x:Name="OpenLogs" Content="Логи ↗" Style="{StaticResource Ghost}" Margin="0,0,4,8"/>
        <Button x:Name="OpenReports" Content="Отчёты ↗" Style="{StaticResource Ghost}" Margin="0,0,4,8"/>
       </WrapPanel>
       <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
        <Button x:Name="HistoryReport" Content="Открыть отчёт" Visibility="Collapsed" Margin="0,0,8,8"/>
        <Button x:Name="HistoryRevert" Content="Откатить запуск" Style="{StaticResource Primary}" Margin="0,0,0,8"/>
       </WrapPanel>
      </Grid>
     </Grid>

     <ScrollViewer x:Name="CollectionsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel/></ScrollViewer>

     <!-- Settings: InitializeResponsive moves these cards into an adaptive grid. -->
     <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
      <StackPanel>
       <Border Style="{StaticResource Card}" Padding="22">
        <StackPanel>
         <TextBlock Text="Обновления Wintools" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold"/>
         <TextBlock x:Name="UpdateStatus" Text="Проверяем наличие новой версии…" Style="{StaticResource MutedText}" Margin="0,8,0,10"/>
         <CheckBox x:Name="AutoCheck" Content="Проверять при запуске и каждые 6 часов"/>
         <CheckBox x:Name="AutoInstall" Content="Скачивать и устанавливать найденное обновление при закрытии"/>
         <CheckBox x:Name="PreviewChannel" Content="Получать предварительные версии (RC)"/>
         <TextBlock x:Name="UpdateMode" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0"/>
         <TextBlock Text="Токен и вход в GitHub не нужны. Обновление устанавливается после закрытия приложения: в следующий раз откроется новая версия. История и данные для отката сохраняются." Style="{StaticResource MutedText}" FontSize="13" Margin="0,8,0,0"/>
         <ProgressBar x:Name="DownloadProgress" Margin="0,16,0,0" Visibility="Collapsed"/>
         <WrapPanel Margin="0,16,0,0">
          <Button x:Name="CheckUpdates" Content="Проверить сейчас" Margin="0,0,8,8"/>
          <Button x:Name="InstallUpdate" Content="Обновить и перезапустить" Style="{StaticResource Primary}" Visibility="Collapsed" Margin="0,0,0,8"/>
         </WrapPanel>
        </StackPanel>
       </Border>
       <Border Style="{StaticResource Card}" Padding="22">
        <StackPanel>
         <TextBlock Text="Оформление" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold"/>
         <TextBlock Text="Цветовая тема" FontWeight="SemiBold" Margin="0,14,0,6"/>
         <ComboBox x:Name="Theme" Width="240" HorizontalAlignment="Left" AutomationProperties.Name="Цветовая тема">
          <ComboBoxItem Content="Как в Windows"/><ComboBoxItem Content="Светлая"/><ComboBoxItem Content="Тёмная"/>
         </ComboBox>
         <TextBlock Text="Тема применяется сразу. «Как в Windows» следует системной настройке и высокой контрастности." Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0"/>
         <!-- The second word is in the other language, so someone who cannot read the current one still finds the switch. -->
         <StackPanel Orientation="Horizontal" Margin="0,16,0,6">
          <TextBlock Text="Язык интерфейса" FontWeight="SemiBold"/>
          <TextBlock Text="Language" Style="{StaticResource MutedText}" Margin="8,0,0,0"/>
         </StackPanel>
         <ComboBox x:Name="Language" Width="240" HorizontalAlignment="Left" AutomationProperties.Name="Язык интерфейса">
          <ComboBoxItem Content="Как в Windows"/><ComboBoxItem Content="Русский"/><ComboBoxItem Content="English"/>
         </ComboBox>
         <TextBlock Text="Язык применится после перезапуска Wintools." Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0"/>
         <TextBlock Text="Размер текста" FontWeight="SemiBold" Margin="0,16,0,6"/>
         <ComboBox x:Name="TextSize" Width="240" HorizontalAlignment="Left" AutomationProperties.Name="Размер текста">
          <ComboBoxItem Content="Как в Windows"/><ComboBoxItem Content="Обычный"/><ComboBoxItem Content="Крупный · 125 %"/><ComboBoxItem Content="Очень крупный · 150 %"/>
         </ComboBox>
         <TextBlock Text="Увеличивает весь интерфейс сразу. «Как в Windows» следует параметру «Размер текста» в специальных возможностях." Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0"/>
        </StackPanel>
       </Border>
       <Border Style="{StaticResource Card}" Padding="22">
        <StackPanel>
         <TextBlock Text="Защита перед изменениями" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold"/>
         <CheckBox x:Name="RestorePoint" Content="Запрашивать точку восстановления Windows" Margin="0,12,0,8"/>
         <TextBlock Text="Если Windows не сможет создать точку, причина появится в выводе. Прежние значения настроек Wintools сохраняет отдельно для отката." Style="{StaticResource MutedText}" FontSize="13"/>
         <CheckBox x:Name="VerifyAfterUpdates" Content="Сверять настройки после обновления Windows" Margin="0,12,0,8"/>
         <TextBlock Text="При первом запуске после смены сборки Windows Wintools сравнит применённые настройки с текущими и покажет изменившиеся. Ничего не исправляется без вашего решения." Style="{StaticResource MutedText}" FontSize="13"/>
        </StackPanel>
       </Border>
       <Border Style="{StaticResource Card}" Padding="22">
        <StackPanel>
         <TextBlock Text="Папка WintoolsData" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold"/>
         <TextBlock Text="Здесь находятся ваши настройки, история, резервные копии для отката и рабочие файлы программы. Она позволяет пользоваться Wintools без установки. Для отката прежних изменений сохраняйте папку по исходному пути. Если её удалить, история и возможность вернуть прежние настройки будут потеряны." Style="{StaticResource MutedText}" FontSize="13" Margin="0,8,0,14"/>
         <WrapPanel>
          <Button x:Name="OpenData" Content="Открыть папку данных ↗" Margin="0,0,10,8"/>
          <Button x:Name="DiagnosticBundle" Content="Собрать пакет диагностики" Margin="0,0,0,8" ToolTip="Архив с версиями, ошибками и журналами Wintools для сообщения о проблеме. Имя пользователя и путь профиля заменяются."/>
         </WrapPanel>
        </StackPanel>
       </Border>
      </StackPanel>
     </ScrollViewer>
    </Grid>
   </Grid>

    <!-- Status bar with the expandable operation output. -->
    <Border x:Name="Console" Grid.Row="1" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="36,0,28,0">
     <DockPanel>
      <Grid DockPanel.Dock="Top" MinHeight="40">
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource Success}" VerticalAlignment="Center" Margin="0,0,10,0"/>
       <TextBlock x:Name="Status" Grid.Column="1" Text="Готово к работе" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Foreground="{DynamicResource Muted}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
       <Button x:Name="LogToggle" Grid.Column="2" Content="Подробности  ▾" Style="{StaticResource Ghost}" FontSize="12" Padding="10,4" MinHeight="30" Margin="0,4"/>
      </Grid>
      <TextBox x:Name="Output" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
               Height="110" Margin="0,0,0,10" Padding="10,8" Background="{DynamicResource Surface}" Visibility="Collapsed" Text="Результаты предпросмотра и выполнения появятся здесь."/>
     </DockPanel>
    </Border>
   </Grid>
   </Border>
  </Grid>

  <!-- Confirmation dialog in the manner of a Windows 11 content dialog: the question on the card, the answers on a footer band. -->
  <Grid x:Name="ConfirmOverlay" Background="{DynamicResource Scrim}" Visibility="Collapsed">
   <Grid MaxWidth="560" Margin="24" VerticalAlignment="Center" HorizontalAlignment="Center">
    <Border Background="{DynamicResource Surface}" CornerRadius="8">
     <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="10" Direction="270" Opacity="0.35" Color="Black"/></Border.Effect>
    </Border>
    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8">
     <DockPanel>
      <Border DockPanel.Dock="Bottom" Background="{DynamicResource Layer}" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" CornerRadius="0,0,8,8" Padding="24,20">
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Button x:Name="ConfirmYes" Content="Продолжить" Style="{StaticResource Primary}"/>
        <Button x:Name="ConfirmNo" Grid.Column="2" Content="Отмена"/>
       </Grid>
      </Border>
      <StackPanel Margin="24,24,24,22">
       <StackPanel Orientation="Horizontal">
        <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="20" Foreground="{DynamicResource Warning}"/>
        <TextBlock Text="Подтвердите действие" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0"/>
       </StackPanel>
       <ScrollViewer MaxHeight="320" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
        <TextBlock x:Name="ConfirmText" LineHeight="21"/>
       </ScrollViewer>
      </StackPanel>
     </DockPanel>
    </Border>
   </Grid>
  </Grid>
 </Grid>
</Window>
